# PokePilot replay sidecar environment reference.
#
# Copy the values you actually need into the host-owned
# /opt/pokefarm/replay.env. Keep that file root-readable only (0600).
# Never commit real S3 credentials.
#
# Values below are the recommended starting envelope for the current
# 4-vCPU / 6-GiB dedicated replay VM. Tune only after observing /healthz.

# ---- Durable artifact storage (required for production replay) ----
POKEPILOT_S3_ENDPOINT=https://s3.example.internal
POKEPILOT_S3_BUCKET=pokepilot
POKEPILOT_S3_REGION=us-east-1
POKEPILOT_S3_ACCESS_KEY=REPLACE_ME
POKEPILOT_S3_SECRET_KEY=REPLACE_ME
POKEPILOT_S3_TIMEOUT=60s

# ---- Encoder / GPU ----
LIBVA_DRIVER_NAME=iHD
POKEPILOT_REPLAY_ENCODER=auto
POKEPILOT_VAAPI_DEVICE=/dev/dri/renderD128

# ---- Live broadcast destinations (optional; server-side secrets only) ----
# Leave a provider unset to keep it unavailable in the operator Broadcasts tab.
# The browser receives only provider availability + destination host, never
# endpoint paths or stream keys.
#
# Twitch / YouTube use their standard RTMPS ingest endpoints unless overridden.
# POKEPILOT_BROADCAST_TWITCH_ENDPOINT=rtmps://live.twitch.tv/app
# POKEPILOT_BROADCAST_TWITCH_STREAM_KEY=REPLACE_ME
# POKEPILOT_BROADCAST_YOUTUBE_ENDPOINT=rtmps://a.rtmp.youtube.com/live2
# POKEPILOT_BROADCAST_YOUTUBE_STREAM_KEY=REPLACE_ME
#
# Generic RTMP(S) can use a complete server-side endpoint and optionally append
# a separately stored key. Neither value is returned to operator clients.
# POKEPILOT_BROADCAST_GENERIC_ENDPOINT=rtmps://relay.example.internal/live
# POKEPILOT_BROADCAST_GENERIC_STREAM_KEY=REPLACE_ME

# ---- Offline admission envelope ----
# Maximum durable offline jobs claimed at once. Excess jobs remain queued.
POKEPILOT_REPLAY_MAX_JOBS=2

# Maximum emulator+encoder segment pipelines across all admitted jobs.
POKEPILOT_REPLAY_WORKERS=3

# Do not claim new heavy work below this free-space floor (1 GiB).
POKEPILOT_REPLAY_MIN_SCRATCH_BYTES=1073741824

# Dedicated temp root. Orphan job-* directories are reconciled on startup.
POKEPILOT_REPLAY_SCRATCH_DIR=/tmp/pokepilot-replay

# ---- Deadlines ----
# Bound one claimed render job, including assembly/upload.
POKEPILOT_REPLAY_JOB_TIMEOUT=8h

# Bound one segment encoder/compositor pipeline.
POKEPILOT_REPLAY_SEGMENT_TIMEOUT=2h

# ---- Segment sizing ----
# Source-time window per resumable segment. Valid range: 10..3600 seconds.
POKEPILOT_REPLAY_SEGMENT_SECONDS=300

# ---- Semantic highlight reels ----
# Maximum stitched reel duration. Higher-priority windows win deterministically.
POKEPILOT_HIGHLIGHT_TARGET_SECONDS=480

# Merge windows separated by at most this many seconds.
POKEPILOT_HIGHLIGHT_MERGE_GAP_SECONDS=3

# Optional complete JSON Policy override. Leave unset to use the versioned
# built-in badge/gym/evolution/blackout/recovery/completion policy.
# POKEPILOT_HIGHLIGHT_POLICY_JSON={"version":1,"target_duration_ms":480000,"merge_gap_ms":3000,"rules":[...]}
