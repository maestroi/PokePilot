  "annotations": {
    "list": [
      {
        "name": "Alerts",
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "iconColor": "red",
        "target": {
          "limit": 100,
          "matchAny": false,
          "tags": [],
          "type": "dashboard"
        }
      },
      {
        "name": "Process start",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "enable": true,
        "iconColor": "blue",
        "expr": "changes(process_start_time_seconds{job=~\"${job:pipe}\"}[1m]) > 0",
        "step": "1m",
        "titleFormat": "{{job}} process started",
        "textFormat": "job {{job}} instance {{instance}}"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Scrape targets up",
      "description": "Configured PokePilot jobs Prometheus currently scrapes. A job that was never added does not appear.",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "links": [],
          "color": {
            "mode": "thresholds"
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "(count(up{job=~\"${job:pipe}\"} == 1) or vector(0))",
          "legendFormat": "value",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ]
    },
