          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "100 * sum by (game,failure_type) (rate(pokepilot_run_failures_total{game=~\"${game:regex}\",outcome=\"recovered\"}[$__rate_interval])) / clamp_min(sum by (game,failure_type) (rate(pokepilot_run_failures_total{game=~\"${game:regex}\",outcome=~\"recovered|terminal\"}[$__rate_interval])), 1e-9)",
          "legendFormat": "{{game}} / {{failure_type}}",
          "refId": "A",
          "range": true,
          "instant": false
        }
      ]
    },
    {
      "id": 8,
      "title": "Supervisor retries and confirmed recoveries",
      "description": "Retries are requeued wall generations, whereas confirmed recoveries require subsequent progress.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 12,
        "y": 12,
