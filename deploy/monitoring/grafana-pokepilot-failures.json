    "list": [
      {
        "name": "DS_PROMETHEUS",
        "label": "Prometheus",
        "type": "datasource",
        "query": "prometheus",
        "current": {
          "selected": true,
          "text": "Prometheus",
          "value": "PBFA97CFB590B2093"
        },
        "hide": 0,
        "refresh": 1
      },
      {
        "name": "DS_LOKI",
        "label": "Loki (optional for drill-down)",
        "type": "datasource",
        "query": "loki",
        "current": {
          "selected": true,
          "text": "Loki",
          "value": "P8E80F9AEF21F6940"
        },
        "hide": 0,
        "refresh": 1
      },
      {
        "name": "game",
        "label": "Game",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "query": {
          "query": "label_values(pokepilot_last_successful_run_timestamp_seconds, game)",
          "refId": "StandardVariableQuery"
        },
        "definition": "label_values(pokepilot_last_successful_run_timestamp_seconds, game)",
        "refresh": 1,
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "sort": 1
      }
    ]
  },
  "annotations": {
    "list": [
      {
        "name": "Alerts",
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
