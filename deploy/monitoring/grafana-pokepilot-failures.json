    {
      "id": 10,
      "title": "Terminal runs vs completions",
      "description": "Terminal run counts, not objective occurrences. Compare actual failed vs completed campaigns.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 12,
        "y": 20,
        "w": 12,
