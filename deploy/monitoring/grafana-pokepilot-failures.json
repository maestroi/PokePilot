      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum by (game,failure_type) (rate(pokepilot_run_failures_total{game=~\"${game:regex}\",outcome=\"terminal\"}[$__rate_interval]))",
          "legendFormat": "{{game}} / {{failure_type}}",
          "refId": "A",
          "range": true,
          "instant": false
        }
      ]
    },
    {
      "id": 7,
      "title": "Recovery rate by cause",
      "description": "Resolved occurrence recovery rate by bounded category. Sparse series can be noisy.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
