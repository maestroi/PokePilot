    {
      "id": 5,
      "title": "LLM completion rate",
      "description": "Completed divided by completed, failed, and aborted LLM-mode runs since the counter reset. Unresolved runs are not in the denominator.",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 19,
        "y": 0,
        "w": 5,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "links": [],
          "color": {
            "mode": "thresholds"
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.25
              },
              {
                "color": "green",
                "value": 0.5
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "((sum(pokepilot_runs_completed_total{game=~\"${game:regex}\",mode=\"llm\"}) or vector(0)) / clamp_min((sum(pokepilot_runs_completed_total{game=~\"${game:regex}\",mode=\"llm\"}) or vector(0)) + (sum(pokepilot_runs_failed_total{game=~\"${game:regex}\",mode=\"llm\"}) or vector(0)) + (sum(pokepilot_runs_aborted_total{game=~\"${game:regex}\",mode=\"llm\"}) or vector(0)), 1))",
          "legendFormat": "value",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ]
    },
    {
