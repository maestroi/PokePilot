  "templating": {
    "list": [
      {
        "name": "DS_PROMETHEUS",
        "label": "Prometheus",
        "type": "datasource",
        "query": "prometheus",
        "current": {
          "selected": true,
          "text": "Prometheus",
          "value": "PBFA97CFB590B2093"
        },
        "hide": 0,
        "refresh": 1
      },
      {
        "name": "DS_LOKI",
        "label": "Loki (optional for drill-down)",
        "type": "datasource",
        "query": "loki",
        "current": {
          "selected": true,
          "text": "Loki",
          "value": "P8E80F9AEF21F6940"
        },
        "hide": 0,
        "refresh": 1
      },
      {
        "name": "game",
        "label": "Game",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "query": {
          "query": "label_values(pokepilot_last_successful_run_timestamp_seconds, game)",
          "refId": "StandardVariableQuery"
        },
        "definition": "label_values(pokepilot_last_successful_run_timestamp_seconds, game)",
        "refresh": 1,
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "sort": 1
      }
    ]
  },
  "annotations": {
    "list": [
      {
        "name": "Alerts",
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "iconColor": "red",
        "target": {
          "limit": 100,
          "matchAny": false,
          "tags": [],
          "type": "dashboard"
        }
      },
      {
        "name": "Wall process start",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "enable": true,
        "iconColor": "blue",
        "expr": "changes(process_start_time_seconds{job=\"pokepilot-wall\"}[1m]) > 0",
        "step": "1m",
        "titleFormat": "wall process started",
        "textFormat": "job {{job}} instance {{instance}}"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Active runs",
      "description": "Runs leased or running right now. Rebuilt from wall state after a restart.",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "links": [],
          "color": {
            "mode": "thresholds"
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum(pokepilot_runs_active{game=~\"${game:regex}\"})",
          "legendFormat": "value",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ]
    },
    {
