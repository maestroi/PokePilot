    {
      "id": 8,
      "title": "Successful runtime p95",
      "description": "p95 of completed runs observed by this wall process. 0 until the first completion is exported. Uses the cumulative histogram so the value remains when no new run finishes during the dashboard range.",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 6,
        "y": 4,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "links": [],
          "color": {
