{
  "editable": true,
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "timepicker": {},
  "uid": "pokepilot-runs",
  "title": "PokePilot / Runs & Progression",
  "description": "Completion, runtime, and the progression funnel from metrics the wall already exports.",
  "tags": [
    "pokepilot",
    "observability",
    "runs"
  ],
  "templating": {
    "list": [
      {
        "name": "DS_PROMETHEUS",
        "label": "Prometheus",
        "type": "datasource",
        "query": "prometheus",
        "current": {
          "selected": true,
          "text": "Prometheus",
          "value": "PBFA97CFB590B2093"
        },
        "hide": 0,
        "refresh": 1
      },
      {
        "name": "DS_LOKI",
        "label": "Loki (optional for drill-down)",
        "type": "datasource",
        "query": "loki",
        "current": {
          "selected": true,
          "text": "Loki",
          "value": "P8E80F9AEF21F6940"
        },
        "hide": 0,
        "refresh": 1
      },
      {
        "name": "game",
        "label": "Game",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "query": {
          "query": "label_values(pokepilot_last_successful_run_timestamp_seconds, game)",
          "refId": "StandardVariableQuery"
        },
        "definition": "label_values(pokepilot_last_successful_run_timestamp_seconds, game)",
        "refresh": 1,
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "sort": 1
      }
    ]
  },
  "annotations": {
    "list": [
      {
        "name": "Alerts",
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "iconColor": "red",
        "target": {
          "limit": 100,
          "matchAny": false,
          "tags": [],
          "type": "dashboard"
        }
      },
      {
        "name": "Wall process start",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "enable": true,
        "iconColor": "blue",
        "expr": "changes(process_start_time_seconds{job=\"pokepilot-wall\"}[1m]) > 0",
        "step": "1m",
        "titleFormat": "wall process started",
        "textFormat": "job {{job}} instance {{instance}}"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Milestones over time",
      "description": "Stages reached since this wall process started. Drawn from the counter, so the line remains when the stage is not currently increasing.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "links": [],
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum by (milestone) (pokepilot_run_milestones_total{game=~\"${game:regex}\"})",
          "legendFormat": "{{milestone}}",
          "refId": "A",
          "instant": false,
          "range": true
        }
      ]
    },
    {
      "id": 2,
      "title": "Runtime by result",
      "description": "p95 time to a completed or failed result for runs this process has finished. Flat 0 until that histogram is exported.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 24,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "links": [],
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "(histogram_quantile(0.95, sum by (le, game) (pokepilot_run_duration_seconds_bucket{game=~\"${game:regex}\",result=\"completed\"})) or on() vector(0))",
          "legendFormat": "{{game}} completed p95",
          "refId": "A",
          "instant": false,
          "range": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "(histogram_quantile(0.95, sum by (le, game) (pokepilot_run_duration_seconds_bucket{game=~\"${game:regex}\",result=\"failed\"})) or on() vector(0))",
          "legendFormat": "{{game}} failed p95",
          "refId": "B",
          "instant": false,
          "range": true
        }
      ]
    },
    {
      "id": 3,
      "title": "Milestones reached",
      "description": "How many campaigns reached each stage since this wall process started. Badge numbers are zero-padded so badge_01 sorts before badge_10.",
      "type": "bargauge",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "links": [],
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "showUnfilled": true
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "label_replace(sum by (milestone) (pokepilot_run_milestones_total{game=~\"${game:regex}\"}), \"milestone\", \"badge_0$1\", \"milestone\", \"badge_([1-9])$\")",
          "legendFormat": "{{milestone}}",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ]
    },
    {
      "id": 4,
      "title": "Where runs stopped",
      "description": "Furthest stage of runs that reached a terminal result on this wall process. 0 at a reached stage means no run has finished there yet.",
      "type": "bargauge",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "links": [],
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "showUnfilled": true
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "(sum by (milestone) (pokepilot_run_stopping_milestone_total{game=~\"${game:regex}\"}) or (sum by (milestone) (pokepilot_run_milestones_total{game=~\"${game:regex}\"}) * 0))",
          "legendFormat": "{{milestone}}",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ]
    },
    {
      "id": 5,
      "title": "Frames on finished runs",
      "description": "p95 emulator frames at a terminal result. Flat 0 until a finished run exports the histogram.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "links": [],
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "(histogram_quantile(0.95, sum by (le, game) (pokepilot_run_frames_bucket{game=~\"${game:regex}\"})) or on() vector(0))",
          "legendFormat": "{{game}} p95",
          "refId": "A",
          "instant": false,
          "range": true
        }
      ]
    },
    {
      "id": 6,
      "title": "Planner rounds on finished runs",
      "description": "p95 planner rounds at a terminal result. Flat 0 until a finished run exports the histogram.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "links": [],
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "(histogram_quantile(0.95, sum by (le, game) (pokepilot_run_rounds_bucket{game=~\"${game:regex}\"})) or on() vector(0))",
          "legendFormat": "{{game}} p95",
          "refId": "A",
          "instant": false,
          "range": true
        }
      ]
    }
  ]
}
