[Unit]
Description=PokePilot qwagent farm-triage attempt

[Service]
Type=oneshot
Nice=10
EnvironmentFile=-%h/.config/pokepilot/env
Environment=PATH=%h/.cursor/bin:%h/.opencode/bin:%h/go/bin:%h/.local/bin:/usr/local/go/bin:/usr/local/bin:/usr/bin:/bin
Environment=POKEMON_RED_ROM=%h/.config/pokepilot/pokemon_red.gb
Environment=POKEPILOT_MCP_URL=https://admin.rompilot.app/mcp
# Run from a dedicated checkout reset to origin/main every tick, not the
# operator's working tree: merged fixer changes apply unattended, and a
# feature branch checked out by hand never changes the picker binary.
Environment=POKEPILOT_ROOT=%h/.local/share/pokepilot/fixer-src
ExecStartPre=/bin/sh -c 'test -d "$POKEPILOT_ROOT/.git" || git clone @@POKEPILOT_ORIGIN@@ "$POKEPILOT_ROOT"; git -C "$POKEPILOT_ROOT" fetch -q origin && git -C "$POKEPILOT_ROOT" checkout -qf -B main origin/main'
ExecStart=%h/.local/share/pokepilot/fixer-src/deploy/qwagent-triage.sh
